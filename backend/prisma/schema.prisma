generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERATIONS_MANAGER
  DISPATCHER
  DRIVER
  ACCOUNTANT
  VIEWER
}

enum VehicleType {
  CAMION
  TRACTOR
  SEMIRREMOLQUE
  SEMI_CISTERNA
  CARRETON
  BATEA
  BITREN
  CAMIONETA
  EQUIPO_ESPECIAL
  CISTERNA
  VOLQUETE
  ACOPLADO
}

enum VehicleStatus {
  DISPONIBLE
  EN_VIAJE
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
  RESERVADO
}

enum TripStatus {
  PENDIENTE
  PROGRAMADO
  EN_CURSO
  FINALIZADO
  CANCELADO
  DEMORADO
}

enum MaintenanceType {
  PREVENTIVO
  CORRECTIVO
}

enum MaintenanceStatus {
  PENDIENTE
  EN_CURSO
  COMPLETADO
  CANCELADO
}

enum DocumentType {
  SEGURO
  ITV
  RUTA
  LICENCIA_CONDUCIR
  CARTA_DE_PORTE
  REMITO
  CONTRATO
  HOJA_RUTA
  CERTIFICADO_MEDICO
  HOJA_SEGURIDAD
  OTRO
}

enum DangerousGoodsClass {
  CLASE_1_EXPLOSIVOS
  CLASE_2_GASES
  CLASE_3_LIQUIDOS_INFLAMABLES
  CLASE_4_SOLIDOS_INFLAMABLES
  CLASE_5_OXIDANTES
  CLASE_6_TOXICOS
  CLASE_7_RADIOACTIVOS
  CLASE_8_CORROSIVOS
  CLASE_9_VARIOS
}

enum InvoiceStatus {
  BORRADOR
  EMITIDA
  PAGADA
  VENCIDA
  ANULADA
}

enum InvoiceType {
  FACTURA_A
  FACTURA_B
  FACTURA_C
  REMITO
  NOTA_CREDITO
  NOTA_DEBITO
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  firstName   String
  lastName    String
  role        UserRole  @default(VIEWER)
  phone       String?
  avatarUrl   String?
  isActive    Boolean   @default(true)
  mfaEnabled  Boolean   @default(false)
  mfaSecret   String?
  lastLogin   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  auditLogs     AuditLog[]
  assignedTrips Trip[]     @relation("DispatcherTrips")

  @@map("users")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Client {
  id                String   @id @default(cuid())
  razonSocial       String
  cuit              String   @unique
  domicilio         String
  ciudad            String
  provincia         String
  codigoPostal      String?
  telefono          String?
  email             String?
  contactoPrincipal String?
  condicionIVA      String   @default("RESPONSABLE_INSCRIPTO")
  categoriaCliente  String   @default("STANDARD")
  isActive          Boolean  @default(true)
  notas             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contacts ClientContact[]
  contracts Contract[]
  trips     Trip[]
  invoices  Invoice[]
  certifications Certification[]

  @@map("clients")
}

model ClientContact {
  id        String  @id @default(cuid())
  clientId  String
  nombre    String
  cargo     String?
  telefono  String?
  email     String?
  isPrimary Boolean @default(false)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_contacts")
}

model Contract {
  id                   String    @id @default(cuid())
  clientId             String
  numero               String    @unique
  descripcion          String?
  cantidadViajes       Int?
  pesoMinimoKg         Float?    @default(30000)
  tarifaBase           Float?
  tarifaExcedentePorTn Float?
  fechaInicio          DateTime
  fechaFin             DateTime?
  tarifas              Json?
  condiciones          String?
  status               String    @default("ACTIVA")
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id])
  trips  Trip[]
  certifications Certification[]

  @@map("contracts")
}

model Vehicle {
  id            String        @id @default(cuid())
  patente       String        @unique
  marca         String
  modelo        String
  anio          Int
  tipo          VehicleType
  capacidadKg   Float?
  capacidadM3   Float?
  tipoCarga     String?
  status        VehicleStatus @default(DISPONIBLE)
  color         String?
  numeroChasis  String?
  numeroMotor   String?
  kilometraje   Float         @default(0)
  horasMotor    Float         @default(0)
  propietario   String?
  isThirdParty  Boolean       @default(false)
  empresa       String?

  vencimientoSeguro       DateTime?
  vencimientoITV          DateTime?
  vencimientoRUTA         DateTime?
  vencimientoEstanqueidad DateTime?
  numeroSeguro            String?
  aseguradora             String?

  cantidadEjes            Int?
  cantidadCompartimentos  Int?
  tipoEnganche            String?

  isActive  Boolean  @default(true)
  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents    Document[]
  maintenances Maintenance[]
  fuelLogs     FuelLog[]
  trips        Trip[]        @relation("VehicleTrips")
  trailerTrips Trip[]        @relation("TrailerTrips")
  gpsDevice    GPSDevice?

  @@map("vehicles")
}

model Driver {
  id          String  @id @default(cuid())
  dni         String  @unique
  firstName   String
  lastName    String
  telefono    String?
  email       String?
  domicilio   String?
  ciudad      String?
  provincia   String?
  cbu         String?
  cuil        String?

  fechaNacimiento DateTime?
  fechaIngreso    DateTime?

  licenciaTipo        String?
  licenciaNumero      String?
  licenciaVencimiento DateTime?

  habilitadoCargasPeligrosas   Boolean   @default(false)
  certificadoCargasPeligrosas  DateTime?
  examenMedicoVencimiento      DateTime?
  psicofisicoVencimiento       DateTime?

  isActive  Boolean  @default(true)
  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents  Document[]
  trips      Trip[]
  trainings  DriverTraining[]
  incidents  Incident[]

  @@map("drivers")
}

model DriverTraining {
  id          String    @id @default(cuid())
  driverId    String
  tipo        String
  fecha       DateTime
  vencimiento DateTime?
  entidad     String?
  aprobado    Boolean   @default(true)
  certificado String?
  notas       String?

  driver Driver @relation(fields: [driverId], references: [id])

  @@map("driver_trainings")
}

model Trip {
  id           String     @id @default(cuid())
  numero       String     @unique
  clientId     String?
  vehicleId    String?
  trailerId    String?
  driverId     String?
  dispatcherId String?

  carrierId        String?
  carrierDriverId  String?
  carrierVehicleId String?
  carrierTrailerId String?

  origen      String
  destino     String
  origenLat   Float?
  origenLon   Float?
  destinoLat  Float?
  destinoLon  Float?

  fechaSalidaProgramada DateTime
  fechaLlegadaEstimada  DateTime
  fechaSalidaReal       DateTime?
  fechaLlegadaReal      DateTime?

  duracionEstimadaHoras   Float?
  esperaEnDestinoHoras    Float   @default(0)
  descansosConductorHoras Float   @default(0)
  leadTimeTotal           Float?
  distanciaKm             Float?

  status TripStatus @default(PENDIENTE)

  tipoCarga        String?
  pesoCarga        Float?
  volumenCarga     Float?
  descripcionCarga String?
  numeroRemito     String?
  numeroOCCliente  String?

  tipoOperacion     String   @default("PROPIA")
  subcontractorName String?
  subcontractorFee  Float?

  esCargaPeligrosa Boolean @default(false)
  esMineria        Boolean @default(false)
  esDistribucion   Boolean @default(false)

  tarifaAcordada  Float?
  pesoExcedenteKg Float?
  montoExcedente  Float?
  costoTotal      Float?
  margenBruto     Float?

  contractId String?

  convoyCode        String?

  certificationId     String?
  numeroCertificado   String?
  estadoCertificacion String  @default("SIN_CERTIFICAR")

  motivoCancelacion String?
  notas             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client        Client?        @relation(fields: [clientId], references: [id])
  contract      Contract?      @relation(fields: [contractId], references: [id])
  certification Certification? @relation(fields: [certificationId], references: [id])
  vehicle       Vehicle?       @relation("VehicleTrips", fields: [vehicleId], references: [id])
  trailer       Vehicle?       @relation("TrailerTrips", fields: [trailerId], references: [id])
  driver        Driver?        @relation(fields: [driverId], references: [id])
  dispatcher    User?          @relation("DispatcherTrips", fields: [dispatcherId], references: [id])

  carrier        Carrier?        @relation(fields: [carrierId], references: [id])
  carrierDriver  CarrierDriver?  @relation(fields: [carrierDriverId], references: [id])
  carrierVehicle CarrierVehicle? @relation("CarrierVehicleTrips", fields: [carrierVehicleId], references: [id])
  carrierTrailer CarrierVehicle? @relation("CarrierTrailerTrips", fields: [carrierTrailerId], references: [id])

  dangerousGoods DangerousGoodsDeclaration?
  costs          TripCost[]
  checkpoints    TripCheckpoint[]
  documents      Document[]
  incidents      Incident[]
  invoiceItems   InvoiceItem[]
  fuelLogs       FuelLog[]

  @@index([status])
  @@index([vehicleId])
  @@index([driverId])
  @@index([clientId])
  @@index([tipoOperacion])
  @@index([esCargaPeligrosa])
  @@index([fechaSalidaProgramada])
  @@index([convoyCode])
  @@index([carrierId])
  @@map("trips")
}

model TripCheckpoint {
  id        String    @id @default(cuid())
  tripId    String
  nombre    String
  ubicacion String
  lat       Float?
  lon       Float?
  estimado  DateTime
  real      DateTime?
  orden     Int       @default(0)
  notas     String?
  createdAt DateTime  @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("trip_checkpoints")
}

model DangerousGoodsDeclaration {
  id              String              @id @default(cuid())
  tripId          String              @unique
  numeroONU       String
  clase           DangerousGoodsClass
  nombreTecnico   String
  cantidadKg      Float?
  grupoEmbalaje   String?
  puntoInflamacion Float?

  hojaSeguridad     Boolean @default(false)
  equipoObligatorio Boolean @default(false)
  permisosCompletos Boolean @default(false)
  cumpleNormativa   Boolean @default(false)

  notas String?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("dangerous_goods_declarations")
}

model Maintenance {
  id        String            @id @default(cuid())
  vehicleId String
  numeroOT  String?           @unique
  tipo      MaintenanceType
  status    MaintenanceStatus @default(PENDIENTE)

  descripcion  String
  fecha        DateTime?
  kmActual     Float?
  kmProximo    Float?
  fechaProxima DateTime?
  horasActual  Float?
  horasProxima Float?

  taller         String?
  tallerTelefono String?
  mecanico       String?
  costoManoObra  Float?
  costoRepuestos Float?
  costoTotal     Float?
  garantiaHasta  DateTime?
  origen         String    @default("MANUAL")

  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle   Vehicle           @relation(fields: [vehicleId], references: [id])
  documents Document[]
  items     MaintenanceItem[]

  @@index([vehicleId])
  @@index([status])
  @@map("maintenances")
}

model MaintenanceItem {
  id             String     @id @default(cuid())
  maintenanceId  String
  sparePartId    String?
  descripcion    String
  repuestoCodigo String?
  cantidad       Float      @default(1)
  costoUnitario  Float      @default(0)
  costoTotal     Float      @default(0)
  createdAt      DateTime   @default(now())

  maintenance Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  sparePart   SparePart?  @relation(fields: [sparePartId], references: [id])

  @@index([maintenanceId])
  @@index([sparePartId])
  @@map("maintenance_items")
}

model SparePart {
  id                 String   @id @default(cuid())
  sku                String   @unique
  nombre             String
  categoria          String   @default("FILTROS")
  ambito             String   @default("UNIVERSAL")
  stockActual        Float    @default(0)
  stockMinimo        Float    @default(1)
  precioUnitario     Float    @default(0)
  ubicacion          String?
  tiposCompatibles   String?  @default("TODOS")
  marcasCompatibles  String?  @default("TODAS")
  tipoEnganche       String?  @default("TODOS")
  modelosCompatibles String?
  imagenUrl          String?
  notas              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items MaintenanceItem[]

  @@index([sku])
  @@index([categoria])
  @@index([ambito])
  @@map("spare_parts")
}

enum ConsumableType {
  DIESEL
  UREA
  ACEITE_MOTOR
  LUBRICANTE
  ADITIVO
  OTRO
}

model FuelLog {
  id        String @id @default(cuid())
  vehicleId String
  tripId    String?

  fecha               DateTime
  litros              Float
  precioPorLitro      Float
  costoTotal          Float
  kmActual            Float?
  proveedor           String?
  tipoCombustible     String         @default("DIESEL")
  tipoConsumible      ConsumableType @default(DIESEL)
  estacion            String?
  factura             String?

  rendimientoKmL      Float?
  ratioUreaPorcentaje Float?
  esDesvio            Boolean        @default(false)
  notas               String?

  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  trip    Trip?   @relation(fields: [tripId], references: [id])

  @@index([vehicleId])
  @@index([fecha])
  @@index([tipoConsumible])
  @@map("fuel_logs")
}

model Document {
  id          String       @id @default(cuid())
  tipo        DocumentType
  nombre      String
  descripcion String?

  fileName  String
  filePath  String
  fileSize  Int?
  mimeType  String?

  vehicleId     String?
  driverId      String?
  tripId        String?
  maintenanceId String?

  fechaEmision     DateTime?
  fechaVencimiento DateTime?
  isExpired        Boolean   @default(false)

  createdAt DateTime @default(now())

  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id])
  driver      Driver?      @relation(fields: [driverId], references: [id])
  trip        Trip?        @relation(fields: [tripId], references: [id])
  maintenance Maintenance? @relation(fields: [maintenanceId], references: [id])

  @@map("documents")
}

model TripCost {
  id          String   @id @default(cuid())
  tripId      String
  categoria   String
  descripcion String?
  monto       Float
  fecha       DateTime @default(now())
  comprobante String?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("trip_costs")
}

model Invoice {
  id       String        @id @default(cuid())
  numero   String        @unique
  clientId String
  tipo     InvoiceType   @default(FACTURA_A)
  status   InvoiceStatus @default(BORRADOR)

  fechaEmision     DateTime  @default(now())
  fechaVencimiento DateTime?

  subtotal Float @default(0)
  iva      Float @default(0)
  total    Float @default(0)

  afipCAE            String?
  afipCAEVencimiento DateTime?
  afipPDFUrl         String?

  certificationId String?

  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client        Client         @relation(fields: [clientId], references: [id])
  certification Certification? @relation(fields: [certificationId], references: [id])
  items         InvoiceItem[]

  @@index([clientId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  tripId      String?
  descripcion String
  cantidad    Float   @default(1)
  precioUnit  Float
  subtotal    Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  trip    Trip?   @relation(fields: [tripId], references: [id])

  @@map("invoice_items")
}

model Incident {
  id       String  @id @default(cuid())
  tripId   String?
  driverId String?

  tipo          String
  descripcion   String
  fecha         DateTime
  lugar         String?
  costoEstimado Float?
  resolucion    String?

  createdAt DateTime @default(now())

  trip   Trip?   @relation(fields: [tripId], references: [id])
  driver Driver? @relation(fields: [driverId], references: [id])

  @@map("incidents")
}

model GPSDevice {
  id        String  @id @default(cuid())
  vehicleId String? @unique

  deviceId  String  @unique
  proveedor String
  modelo    String?
  imei      String?
  isActive  Boolean @default(true)

  lastLat    Float?
  lastLon    Float?
  lastUpdate DateTime?
  lastSpeed  Float?
  lastEvent  String?

  createdAt DateTime @default(now())

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@map("gps_devices")
}

model Geofence {
  id          String  @id @default(cuid())
  nombre      String
  descripcion String?
  coordinates Json
  radio       Float?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())

  @@map("geofences")
}

model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique
  value Json
  label String?

  @@map("system_config")
}

enum CertificationStatus {
  BORRADOR
  EN_REVISION
  APROBADO
  FACTURADO
  RECHAZADO
}

model Certification {
  id                  String              @id @default(cuid())
  numeroCertificado   Int                 // 1, 2, 3... correlativo por cliente
  clientId            String
  contractId          String?
  numeroOC            String?             // N° Orden de Compra
  periodo             String?             // Ej: "Enero 2026"
  fechaEmision        DateTime            @default(now())
  fechaAprobacion     DateTime?
  cantidadViajes      Int                 @default(0)
  toneladasExcedentes Float               @default(0)
  montoTotal          Float               @default(0)
  estado              CertificationStatus @default(EN_REVISION)
  diasEnGestion       Int?                @default(0)
  observaciones       String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  client   Client    @relation(fields: [clientId], references: [id])
  contract Contract? @relation(fields: [contractId], references: [id])
  trips    Trip[]
  invoices Invoice[]

  @@unique([clientId, numeroCertificado])
  @@index([clientId])
  @@index([estado])
  @@map("certifications")
}

model Carrier {
  id            String   @id @default(cuid())
  razonSocial   String
  cuit          String?  @unique
  telefono      String?
  email         String?
  contacto      String?
  domicilio     String?
  ciudad        String?
  provincia     String?
  isActive      Boolean  @default(true)
  notas         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicles  CarrierVehicle[]
  drivers   CarrierDriver[]
  trips     Trip[]

  @@map("carriers")
}

model CarrierVehicle {
  id          String       @id @default(cuid())
  carrierId   String
  patente     String       @unique
  tipo        VehicleType?
  marca       String?
  modelo      String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  carrier      Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  trips        Trip[]  @relation("CarrierVehicleTrips")
  trailerTrips Trip[]  @relation("CarrierTrailerTrips")

  @@index([carrierId])
  @@map("carrier_vehicles")
}

model CarrierDriver {
  id          String   @id @default(cuid())
  carrierId   String
  firstName   String
  lastName    String
  dni         String?
  telefono    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  carrier Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  trips   Trip[]

  @@index([carrierId])
  @@map("carrier_drivers")
}
