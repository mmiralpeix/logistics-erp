# =============================================================
# LogisticsPro ERP - Backend Environment Variables Example
# =============================================================

# Railway PostgreSQL Database URL - on Railway this is injected automatically
# via a service reference; for local dev, use `railway connect` to tunnel in.
DATABASE_URL="postgresql://user:password@localhost:5432/logistics_erp"

# Server Port (Railway automatically sets PORT)
PORT=3001
NODE_ENV=production

# JWT Authentication
JWT_SECRET=replace_this_with_a_secure_jwt_secret_key_for_production
JWT_EXPIRES_IN=7d

# Allowed Frontend URL(s) for CORS (comma-separated list)
FRONTEND_URL=https://logisticspro-erp.up.railway.app

# Maximum file upload size
UPLOAD_MAX_SIZE=50mb

# Redis Cache (Optional / External Redis URL)
REDIS_URL=redis://default:password@redis-host:6379

# Set to "true" to auto-populate the DB with 50+ demo rows per entity on boot
# when core tables are nearly empty. Leave unset/false in any environment with
# real data - this is a dev/demo-only convenience, never enable in production.
AUTO_SEED_ON_BOOT=false
