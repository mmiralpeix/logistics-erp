# =============================================================
# LogisticsPro ERP - Backend Environment Variables Example
# =============================================================

# Neon PostgreSQL Database URL
DATABASE_URL="postgresql://user:password@ep-sample-host.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Server Port (Railway automatically sets PORT)
PORT=3001
NODE_ENV=production

# JWT Authentication
JWT_SECRET=replace_this_with_a_secure_jwt_secret_key_for_production
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for CORS (Vercel deployment domain or comma-separated list)
FRONTEND_URL=https://logistics-erp.vercel.app

# Maximum file upload size
UPLOAD_MAX_SIZE=50mb

# Redis Cache (Optional / External Redis URL)
REDIS_URL=redis://default:password@redis-host:6379
