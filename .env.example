# =============================================================
# LogisticsPro ERP - General Environment Variables Example
# =============================================================

# Base de datos PostgreSQL (Neon)
DATABASE_URL="postgresql://user:password@ep-sample-host.sa-east-1.aws.neon.tech/neondb?sslmode=require"
POSTGRES_USER=logistics_user
POSTGRES_PASSWORD=logistics_pass_2024
POSTGRES_DB=logistics_erp

# JWT
JWT_SECRET=replace_this_with_a_secure_jwt_secret_key_for_production
JWT_EXPIRES_IN=7d

# Backend (Railway)
PORT=3001
NODE_ENV=production

# Frontend (Vercel)
NEXT_PUBLIC_API_URL=https://logistics-erp-backend.up.railway.app/api
NEXT_PUBLIC_APP_NAME=LogisticsPro ERP
FRONTEND_URL=https://logistics-erp.vercel.app

# Uploads
UPLOAD_MAX_SIZE=50mb
