# =============================================================
# LogisticsPro ERP - General Environment Variables Example
# =============================================================

# Base de datos PostgreSQL (Railway) - en Railway se inyecta automáticamente
# via referencia al servicio Postgres; para desarrollo local, usar el túnel
# de `railway connect` en vez de una URL fija.
DATABASE_URL="postgresql://user:password@localhost:5432/logistics_erp"
POSTGRES_USER=logistics_user
POSTGRES_PASSWORD=logistics_pass_2024
POSTGRES_DB=logistics_erp

# JWT
JWT_SECRET=replace_this_with_a_secure_jwt_secret_key_for_production
JWT_EXPIRES_IN=7d

# Backend (Railway)
PORT=3001
NODE_ENV=production

# Frontend (Railway)
NEXT_PUBLIC_API_URL=https://logistics-erp-production-ff4a.up.railway.app/api
NEXT_PUBLIC_APP_NAME=LogisticsPro ERP
FRONTEND_URL=https://logisticspro-erp.up.railway.app

# Uploads
UPLOAD_MAX_SIZE=50mb
