{
  "name": "logisticspro-erp",
  "version": "1.0.0",
  "description": "LogisticsPro ERP - Sistema de Gestión Logística Empresarial",
  "main": "electron/main.js",
  "author": "LogisticsPro",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./start-app.ps1",
    "index": "powershell -ExecutionPolicy Bypass -File ./.agents/scripts/update-graph.ps1",
    "graph:serve": "powershell -ExecutionPolicy Bypass -File ./.agents/scripts/serve-graph.ps1",
    "test:agents": "powershell -ExecutionPolicy Bypass -File ./.agents/scripts/run-tests.ps1",
    "electron": "electron .",
    "build:backend": "cd backend && npm install && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:backend",
    "start": "cd backend && npm run start:prod",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:preview": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "prisma": "^5.10.0"
  },
  "devDependencies": {
    "electron": "^29.4.0",
    "electron-builder": "^24.13.3"
  }
}
